### Variables
@baseUrl = http://localhost:5000/api/v1
@email = test@example.com
@password = Password123!
@userName = TestUser

### 1. Register User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "userName": "{{userName}}",
    "email": "{{email}}",
    "password": "{{password}}"
}

### 2. Sign In
# Note: Capture the accessToken from this response to use in subsequent requests as {{authToken}}
# @name signin
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}
###
@authToken = {{signin.response.body.data.accessToken}}
### 3. Create Project
# Captures 'slug' from response as {{projectSlug}}
# @name createProject
POST {{baseUrl}}/projects/meta
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "My First Project",
    "slug": "my-project"
}

###
@project_id = {{createProject.response.body.data.id}}
@projectSlug = {{createProject.response.body.data.slug}}

### 4. Get Project
GET {{baseUrl}}/projects/{{projectSlug}}
Authorization: Bearer {{authToken}}

### 5. Update Project Body
# Passing only the updated data in the body
PUT {{baseUrl}}/projects/{{projectSlug}}/meta
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Updated Project Name2",
    "ShortDesc": "Updated description content"
}

### 5.2. Get Project
GET {{baseUrl}}/projects
Authorization: Bearer {{authToken}}



### 6. Create Blog (Scoped to Project)
# Captures 'slug' from response as {{blogSlug}}
# @name createBlog
POST {{baseUrl}}/projects/{{projectSlug}}/blogs/meta
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "My First Blog Post",
    "slug": "my-blog"
}

###
@blogSlug = {{createBlog.response.body.data.slug}}

### 7. Get Blog
GET {{baseUrl}}/projects/{{projectSlug}}/blogs/{{blogSlug}}
Authorization: Bearer {{authToken}}

### 8. Update Blog Body
# Passing only the updated data in the body
PUT {{baseUrl}}/projects/{{projectSlug}}/blogs/{{blogSlug}}/body
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Updated Blog Title",
    "content": "The content has been changed."
}

### 9. SEARCH TESTS (Unified Search API)

### 9.1 Global Search 
# Searches across all providers (Projects, BlogPosts, etc.) using the current project context
GET {{baseUrl}}/search?query=my&projectId={{project_id}}
Authorization: Bearer {{authToken}}

### 9.2 Type-Specific Search: Projects
# Filters results to only include entities where SearchType is "Project"
GET {{baseUrl}}/search?query=my&type=Project&projectId={{project_id}}
Authorization: Bearer {{authToken}}

### 9.3 Type-Specific Search: BlogPosts
# Filters results to only include entities where SearchType is "BlogPost"
# Note: This will find the blog post created in step 6
GET {{baseUrl}}/search?query=first&type=BlogPost&projectId={{project_id}}
Authorization: Bearer {{authToken}}

### 9.4 Paged Search Test
# Tests pagination logic (Page 1, 2 results per page)
GET {{baseUrl}}/search?query=my&page=1&pageSize=2&projectId={{project_id}}
Authorization: Bearer {{authToken}}