<MudStack Style="height:100%;width:100%" Wrap="Wrap.NoWrap" Row="true" Reverse="true">
    <MudPaper Style="height:100%">
        <MudStack>
        @ToggleButton
        <RightMenu OnMenuClicked=@OnNavMenuClicked />
        </MudStack>
    </MudPaper>
    <MudPaper Style="height:100%;width:100%" Class="justify-content-center" >
        
        
        <DynamicComponent Type="@_componentType" Parameters="@_parameters"/>
    </MudPaper>
        
</MudStack>

@code {
    [Parameter]
    public RenderFragment? ToggleButton { get; set; }

     [Parameter]
    public EventCallback OnMenuClicked { get; set; }


    private async void OnNavMenuClicked(Type componentType)
    {
        _parameters["Title"] = componentType.Name;
        _componentType = componentType;
        await OnMenuClicked.InvokeAsync();

    }

    private Type _componentType = typeof(Demo.StoryOutline);

    private Dictionary<string, object> _parameters = new Dictionary<string, object>{{"Title",("StoryOutline")}};
}